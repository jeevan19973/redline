# Copy to .env.local and fill in. Never commit .env.local.
# For local development, `npx supabase status -o env` prints both values.

# Supabase project URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key. Safe in the browser; row-level security does the guarding.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
