# Copy to .env.local and fill in. Never commit .env.local.
# For local development, `npx supabase status -o env` prints both values.

# Supabase. Leave these unset to run without accounts: the app still starts,
# but sign-in, the library and Red lines are unavailable.
# Supabase project URL (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key. Safe in the browser; row-level security does the guarding.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Fallback, read only when NEXT_PUBLIC_SUPABASE_ANON_KEY is unset: the
# publishable key, which `npx supabase status -o env` prints as PUBLISHABLE_KEY.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret key. It bypasses row-level security. The app server reads it
# to store and read reports, which no client may touch, and owner scripts read
# it too (npm run invite:create). It must never reach the browser: never prefix
# it with NEXT_PUBLIC_. With Supabase set up and this unset, no analysis runs.
# `npx supabase status -o env` prints it as SECRET_KEY.
SUPABASE_SECRET_KEY=

# OpenRouter key for model calls. Server-only: never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# OpenRouter model id, such as provider/model-name. Never hardcode one (CLAUDE.md).
OPENROUTER_MODEL=

# Set to true to show each Risk flag's Confidence to Signers. Leave unset (off)
# until the Confidence calibration eval passes (ADR 0004). Server-only.
UNDERLINE_SHOW_CONFIDENCE=
